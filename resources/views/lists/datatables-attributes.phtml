<?php

declare(strict_types=1);

// Use the explicit core view so translations and shared table options stay in
// sync with webtrees, without resolving this theme override again.
$attributes = preg_replace_callback(
    '/\bdata-layout=(["\'])(.*?)\1/s',
    static function (array $match): string {
        $layout = json_decode(html_entity_decode($match[2], ENT_QUOTES), true, 512, JSON_THROW_ON_ERROR);

        // DataTables owns both pagers and keeps them in sync after every draw.
        $layout['bottom2'] = 'paging';

        return 'data-layout="' . e(json_encode($layout, JSON_THROW_ON_ERROR)) . '"';
    },
    view('::lists/datatables-attributes')
);

?>

<?= $attributes ?>
